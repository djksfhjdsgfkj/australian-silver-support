    color:#fff;
    text-decoration:none;
    display:grid;
    place-items:center;
    font-size:44px;
    line-height:1;
    font-weight:900
}


/* glossary */
.glossary-label {
    position:absolute;
    left:70px;
    top:27px;
    font-size:15px;
    line-height:20px;
    font-weight:800;
    color:#4b6a92
}

.glossary-title {
    position:absolute;
    left:70px;
    top:54px;
    width:720px;
    font-size:48px;
    line-height:56px;
    font-weight:800;
    margin:0
}

.glossary-intro {
    position:absolute;
    left:70px;
    top:116px;
    width:720px;
    font-size:22px;
    line-height:30px;
    font-weight:600
}

.glossary-help {
    position:absolute;
    left:1020px;
    top:30px;
    width:406px;
    height:116px;
    border:1px solid #bfd0e6;
    border-radius:22px;
    background:#fff;
    box-shadow:0 7px 20px rgba(5,31,74,.09)
}

.info-icon {
    position:absolute;
    left:22px;
    top:27px;
    width:42px;
    height:42px;
    border-radius:50%;
    background:#e8f0fa;
    display:grid;
    place-items:center;
    font-weight:800;
    font-size:23px
}

.glossary-help h3 {
    position:absolute;
    left:78px;
    top:15px;
    margin:0;
    font-size:18px
}

.glossary-help p {
    position:absolute;
    left:78px;
    top:33px;
    width:280px;
    margin:0;
    color:#4b6a92;
    font-size:15px;
    line-height:21px
}

.glossary-card {
    position:absolute;
    width:386px;
    height:205px;
    border:1px solid #d8e4f2;
    border-radius:28px;
    box-shadow:0 7px 20px rgba(5,31,74,.09);
    padding:22px 24px
}

.phishing-card {
    left:70px;
    top:181px;
    background:#f3ffa2
}

.https-card {
    left:520px;
    top:181px;
    background:#fff0a4
}

.malware-card {
    left:970px;
    top:181px;
    background:#dab4fa
}

.password-card {
    left:70px;
    top:426px;
    background:#9ed8fa
}

.two-factor-card {
    left:520px;
    top:426px;
    background:#a9e6f4
}

.public-wifi-card {
    left:970px;
    top:426px;
    background:#e8f0fc
}

.glossary-card h2 {
    font-size:25px;
    line-height:30px;
    margin:0 0 14px
}

.glossary-card p {
    font-size:17px;
    line-height:25px;
    margin:0;
    width:338px
}

.meaning-button {
    position:absolute;
    right:24px;
    bottom:14px;
    width:138px;
    height:34px;
    border:0;
    border-radius:17px;
    background:#062b69;
    color:#fff;
    font-size:14px;
    font-weight:700;
    cursor:pointer
}

.rollover {
    display:none;
    position:absolute;
    left:24px;
    right:24px;
    top:67px;
    background:rgba(255,255,255,.95);
    border-radius:12px;
    padding:10px;
    font-size:15px;
    line-height:20px;
    z-index:3
}

.glossary-card.open .rollover,.glossary-card:hover .rollover {
    display:block
}

.glossary-tip {
    position:absolute;
    left:70px;
    top:654px;
    width:1356px;
    height:35px;
    border-radius:17px;
    background:#e8f0fa;
    color:#4b6a92;
    text-align:center;
    font-size:15px;
    line-height:35px;
    font-weight:600
}


/* about page */
.about-label {
    position:absolute;
    left:80px;
    top:33px;
    font-size:16px;
    line-height:20px;
    font-weight:800;
    color:#4b6a92
}

.about-title {
    position:absolute;
    left:80px;
    top:60px;
    width:660px;
    font-size:52px;
    line-height:58px;
    font-weight:800;
    margin:0
}

.about-intro {
    position:absolute;
    left:80px;
    top:189px;
    width:660px;
    font-size:25px;
    line-height:34px;
    font-weight:600;
    margin:0
}

.mission {
    position:absolute;
    left:790px;
    top:31px;
    width:626px;
    height:252px;
    border-radius:30px;
    background:#062b69;
    color:#fff;
    box-shadow:0 8px 22px rgba(5,31,74,.1);
    padding:34px 40px
}

.mission .mission-label {
    font-size:16px;
    line-height:20px;
    color:#bfd6f6;
    font-weight:800;
    margin:0
}

.mission h2 {
    font-size:32px;
    line-height:39px;
    margin:11px 0 6px
}

.mission p {
    font-size:18px;
    line-height:27px;
    margin:0;
    width:515px
}

.support-title {
    position:absolute;
    left:80px;
    top:328px;
    width:660px;
    font-size:29px;
    line-height:34px;
    margin:0
}

.support-intro {
    position:absolute;
    left:80px;
    top:366px;
    width:760px;
    font-size:19px;
    line-height:27px;
    color:#4b6a92;
    margin:0
}

.value-card {
    position:absolute;
    top:411px;
    width:372px;
    height:220px;
    border:1px solid #d9e5f3;
    border-radius:30px;
    box-shadow:0 8px 22px rgba(5,31,74,.1);
    padding:28px
}

.learn-value {
    left:80px;
    background:#f3ffa2
}

.safe-value {
    left:522px;
    background:#fff0a4
}

.help-value {
    left:964px;
    background:#a9e6f4
}

.value-card h3 {
    font-size:24px;
    line-height:29px;
    margin:0 0 11px
}

.value-card p {
    font-size:18px;
    line-height:27px;
    margin:0
}

.trust-strip {
    position:absolute;
    left:80px;
    top:655px;
    width:1336px;
    height:34px;
    border-radius:17px;
    background:#e8f0fa;
    color:#4b6a92;
    text-align:center;
    font-size:15px;
    line-height:34px;
    font-weight:600
}


/* lesson pages */
.page-content {
    padding:27px 70px
}

.page-label {
    font-size:15px;
    font-weight:800;
    color:#4b6a92;
    margin:0
}

.page-title {
    font-size:48px;
    line-height:56px;
    margin:2px 0 0;
    font-weight:800
}

.page-intro {
    font-size:22px;
    line-height:30px;
    font-weight:600;
    margin:4px 0 20px
}

.lesson-grid {
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:24px
}

.lesson-card {
    height:245px;
    border:1px solid #d8e4f2;
    border-radius:28px;
    box-shadow:0 7px 20px rgba(5,31,74,.09);
    padding:24px
}

.lesson-card:nth-child(1) {
    background:#f3ffa2
}

.lesson-card:nth-child(2) {
    background:#fff0a4
}

.lesson-card:nth-child(3) {
    background:#dab4fa
}

.lesson-card:nth-child(4) {
    background:#a9e6f4
}

.lesson-card h2 {
    font-size:25px;
    margin:0 0 10px
}

.lesson-card p {
    font-size:17px;
    line-height:25px
}

.button {
    display:inline-flex;
    align-items:center;
    justify-content:center;
    background:#062b69;
    color:#fff;
    text-decoration:none;
    border:0;
    border-radius:17px;
    padding:9px 18px;
    font-weight:700;
    cursor:pointer
}

.info-box {
    background:#fff;
    border:1px solid #d8e4f2;
    border-radius:24px;
    box-shadow:0 7px 20px rgba(5,31,74,.09);
    padding:20px 24px;
    margin:15px 0
}

.info-box h2 {
    font-size:25px;
    margin:0 0 7px
}

.info-box p,.info-box li {
    font-size:17px;
    line-height:25px
}

.info-box li {
    margin:5px 0
}

.safe-example {
    background:#effbf1;
    border-left:7px solid #3eb34d;
    padding:12px;
    border-radius:12px
}

.warning-example {
    background:#fff0f2;
    border-left:7px solid #c83c4a;
    padding:12px;
    border-radius:12px
}

.rollover-wrap {
    font-weight:800;
    text-decoration:underline dotted;
    position:relative;
    cursor:help
}

.rollover-wrap span {
    display:none;
    position:absolute;
    left:0;
    top:25px;
    width:260px;
    background:#062b69;
    color:#fff;
    border-radius:10px;
    padding:10px;
    z-index:5;
    font-weight:400
}

.rollover-wrap:hover span,.rollover-wrap:focus span {
    display:block
}

/* escape the scam game */
.game-page {
    width:1000px;
    margin:0 auto
}

.game-info {
    display:flex;
    gap:12px;
    margin:10px 0
}

.game-label {
    background:#fff;
    border:1px solid #d8e4f2;
    border-radius:999px;
    padding:7px 13px;
    font-weight:700
}

.game-progress {
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:8px;
    margin:12px 0
}

.game-progress div {
    height:12px;
    background:#d8e2ef;
    border-radius:8px
}

.game-progress .done {
    background:#3eb34d
}

.question-box {
    background:#fff;
    border:1px solid #d8e4f2;
    border-radius:28px;
    box-shadow:0 7px 20px rgba(5,31,74,.09);
    padding:24px
}

.scenario-box {
    background:#eef4fb;
    border-radius:16px;
    padding:14px;
    margin:10px 0;
    font-size:17px
}

.answer-buttons {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px
}

.answer-button {
    height:100px;
    border:3px solid #cbd7e6;
    border-radius:18px;
    background:#fff;
    color:#062b69;
    text-align:left;
    padding:15px;
    font-weight:600;
    cursor:pointer
}

.feedback {
    display:none;
    margin-top:12px;
    padding:12px;
    border-radius:12px;
    font-weight:700
}

.feedback.show {
    display:block
}

.feedback.good {
    background:#e9faec;
    color:#176b24
}

.feedback.bad {
    background:#fff0f2;
    color:#8c2630
}

.safety-tip {
    background:#fff8d5;
    padding:11px;
    border-radius:12px;
    margin-top:10px
}

.score-box {
    width:760px;
    margin:35px auto;
    background:#fff;
    border-radius:28px;
    box-shadow:0 7px 20px rgba(5,31,74,.09);
    padding:30px;
    text-align:center
}

.score-big {
    font-size:52px;
    font-weight:800
}

.help-grid {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:22px
}

.text-control {
    border:2px solid #062b69;
    background:#fff;
    color:#062b69;
    border-radius:12px;
    padding:9px 14px;
    font-weight:700;
    cursor:pointer
}

@media(max-width:1496px) {
    body {
        overflow-x:auto
    }

    .webpage {
        margin-left:0
    }

}

/* ===== FIGMA TRANSLATED PAGES ===== */
.figma-page { position:absolute; }
.fp-label { position:absolute; left:70px; top:27px; width:700px; height:22px; margin:0; color:#4b6a92; font-size:15px; line-height:20px; font-weight:800; }

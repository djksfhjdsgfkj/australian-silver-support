<h2>CSS</h2>
<h3>style.css</h3><pre>
@font-face {
    font-family:Inter;
    src:local("Inter");
    font-style:normal
}

:root {
    --navy:#062b69;
    --black:#0a0a0a;
    --header:#ececec;
    --page:#f6f9fd;
    --lime:#f3ffa2;
    --yellow:#fff0a4;
    --purple:#dab4fa;
    --blue:#9ed8fa;
    --aqua:#a9e6f4;
    --pale:#e8f0fa;
    --green:#3eb34d;
    --muted:#4b6a92;
    --border:#d8e4f2
}

* {
    box-sizing:border-box
}

html,body {
    margin:0;
    padding:0;
    background:#dfe4ea;
    font-family:Inter,Arial,sans-serif;
    color:var(--navy)
}

a {
    color:inherit
}

button,input {
    font:inherit
}

.webpage {
    width:1496px;
    height:850px;
    position:relative;
    margin:0 auto;
    background:#fff;
    overflow:hidden
}

/* navigation */
.navbar {
    position:absolute;
    left:0;
    top:0;
    width:1496px;
    height:89px;
    background:#ececec;
    border-bottom:4px solid #111;
    z-index:20
}

.logo {
    position:absolute;
    left:8px;
    top:8px;
    width:255px;
    height:72px;
    display:block
}

.logo img {
    width:245px;
    height:72px;
    object-fit:contain;
    object-position:left center
}

.nav-item {
    position:absolute;
    top:20px;
    height:50px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    text-decoration:none;
    color:#0a0a0a;
    font-weight:800;
    font-size:27px;
    line-height:30px;
    border-radius:8px
}

.nav-item:hover,.nav-item:focus {
    background:#fff
}

.nav-item.active {
    color:#062b69
}


    border:3px solid #bfd1e5;
    border-radius:16px;
    padding:17px 20px;
    color:#062b69;
    background:#fff;
    font-family:Inter,Arial,sans-serif;
    font-size:18px;
    line-height:25px;
}

.short-answer:focus {
    outline:4px solid #9ed8fa;
}

.game-feedback {
    left:40px !important;
    top:294px !important;
    width:520px !important;
    min-height:38px !important;
    padding:8px 12px;
    border-radius:10px;
    font-size:16px !important;
    line-height:22px;
}

.game-feedback.visible.correct {
    background:#dff6e4;
    border:2px solid #2c9f3c;
    color:#176b24;
    font-weight:900;
}

.game-feedback.visible.incorrect {
    background:#ffe7ea;
    border:2px solid #cf3546;
    color:#8c2630;
    font-weight:900;
}

.game-teach {
    left:590px !important;
    top:294px !important;

/* final layout fixes */
html, body {
    width:100%;
    min-height:100%;
    margin:0;
    padding:0;
    overflow-x:hidden;
    overflow-y:auto;
}

body {
    display:block;
    background:#dfe4ea;
}

#pageHolder {
    position:relative;
    width:100vw;
    margin:0;
    padding:0;
    overflow:hidden;
}

.webpage {
    margin:0;
    transform-origin:top left;
}

/* slightly larger brand logo while keeping the header height */
.logo {
    left:10px;
    top:4px;
    width:292px;
    height:80px;
}

.logo img {
    width:282px;
    height:80px;
    object-fit:contain;
    object-position:left center;
}

/* footer content is laid out in three clean zones so icons and text cannot overlap */
.footer {
    display:grid;
    grid-template-columns:430px 1fr 390px;
    align-items:center;
    column-gap:34px;
    padding:0 54px;
}

.footer a,
.footer span {
    position:static;
    top:auto;
    height:auto;
    line-height:1.15;
    font-size:22px;
    white-space:nowrap;
}

.help-link,
.support-message,
.safe-message {
    left:auto;
    display:flex;
    align-items:center;
    min-width:0;
}

.support-message {
    justify-self:center;
}

.safe-message {
    justify-self:end;
}

.footer-line {
    display:none;
}

.footer-icon {
    position:static !important;
    display:inline-flex !important;
    align-items:center;
    justify-content:center;
    margin-right:12px;
    min-width:32px;
    font-size:27px !important;
}

/* keep the lesson card icons centred inside the coloured top area */
.card-icon {
    left:50% !important;
    top:12px !important;
    width:112px !important;
    height:72px !important;
    transform:translateX(-50%);
    display:flex;
    align-items:center;
    justify-content:center;
}

.card-icon img {
    display:block;
    width:100%;
    height:100%;
    max-width:112px;
    max-height:72px;
    object-fit:contain;
    object-position:center center;
}

/* glossary definitions are hidden unless the pointer/focus is on that exact button */
.glossary-card .rollover {
    display:none !important;
    position:absolute;
    left:22px;
    right:22px;
    top:70px;
    min-height:92px;
    padding:14px 16px;
    border-radius:14px;
    background:#ffffff;
    color:#062b69;
    box-shadow:0 5px 18px rgba(6,43,105,0.16);
    font-size:16px;
    line-height:22px;
    z-index:10;
    pointer-events:none;
}

.glossary-card:hover .rollover,
.glossary-card.open .rollover {
    display:none !important;
}

.glossary-card .meaning-button:hover + .rollover,
.glossary-card .meaning-button:focus + .rollover,
.glossary-card .meaning-button:focus-visible + .rollover {
    display:block !important;
}

.glossary-card .meaning-button {
    z-index:12;
}

/* expanded Escape the Scam test */
.game-progress {
    display:grid !important;
    grid-template-columns:repeat(10, 1fr) !important;
    gap:8px !important;
    left:70px !important;
    width:1320px !important;
}

.game-progress span {
    width:auto !important;
}

.figma-game-card {
    left:140px !important;
    top:294px !important;

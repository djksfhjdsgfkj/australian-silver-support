}


/* FINAL GLOSSARY ROLLOVER BEHAVIOUR
   The definition can ONLY appear while the exact View meaning button is hovered
   or keyboard-focused. Hovering anywhere else on the card does nothing. */
.glossary-card .rollover {
    display:block !important;
    opacity:0;
    visibility:hidden;
    transform:translateY(6px);
    transition:opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
    pointer-events:none;
}

.glossary-card:hover .rollover,
.glossary-card.open .rollover {
    opacity:0 !important;
    visibility:hidden !important;
}

.glossary-card .meaning-button:hover + .rollover,
.glossary-card .meaning-button:focus + .rollover,
.glossary-card .meaning-button:focus-visible + .rollover {
    opacity:1 !important;
    visibility:visible !important;
    transform:translateY(0);
}

.meaning-button {
    transition:transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
}

.meaning-button:hover,
.meaning-button:focus-visible {
    transform:translateY(-2px);
    box-shadow:0 5px 12px rgba(6,43,105,0.22);
    outline:3px solid rgba(158,216,250,0.9);
    outline-offset:2px;
}

/* Keep the safe-website lock/image perfectly centred within its icon area. */
.website-card .card-icon {
    left:50% !important;
    transform:translateX(-50%);
    display:flex;
    align-items:center;
    justify-content:center;
}

.website-card .card-icon img {
    display:block;
    margin:auto;
    object-fit:contain;
    object-position:center center;
}



    min-height:38px !important;
    padding:8px 12px;
    border-radius:10px;
    background:#fff7cf;
    font-size:15px !important;
    line-height:21px;
}

.check-answer,
.game-next {
    position:absolute;
    top:650px !important;
    height:46px;
    border:0;
    border-radius:17px;
    color:#fff;
    font-size:18px;
    font-weight:800;
    cursor:pointer;
}

.check-answer {
